# Database & Authentication Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberwatch
JWT_SECRET=supersecretjwtkeyforcyberwatchplatform
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Threat Intelligence Vendor API Keys (Optional)
# 1. Google Safe Browsing API v4 (https://console.cloud.google.com/apis/credentials)
GOOGLE_SAFE_BROWSING_API_KEY=

# 2. VirusTotal API v3 (https://www.virustotal.com/gui/user/username/apikey)
VIRUSTOTAL_API_KEY=

# 3. abuse.ch URLhaus API Auth-Key (https://urlhaus.abuse.ch/api/)
URLHAUS_API_KEY=

# 4. PhishTank API Key (Optional - Public queries supported without key) (https://www.phishtank.com/api_register.php)
PHISHTANK_API_KEY=
